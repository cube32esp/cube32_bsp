# CUBE32 sdkconfig.defaults — hello_rtc_ntp
# Applied first by ESP-IDF; target-specific overrides go in sdkconfig.defaults.<target>

# ---------------------------------------------------------------------------
# [ALWAYS ON] Compiler
# ---------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_CXX_RTTI=y

# ---------------------------------------------------------------------------
# [ALWAYS ON] Bootloader
# ---------------------------------------------------------------------------
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---------------------------------------------------------------------------
# [ALWAYS ON] Partition table — standard CUBE32 16 MB layout
# ---------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---------------------------------------------------------------------------
# [ALWAYS ON] FreeRTOS
# ---------------------------------------------------------------------------
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---------------------------------------------------------------------------
# [ALWAYS ON] Newlib — smaller footprint
# ---------------------------------------------------------------------------
CONFIG_NEWLIB_NANO_FORMAT=y

# ---------------------------------------------------------------------------
# [ALWAYS ON] UART ISR in IRAM — prevents UART FIFO overflow during flash
# ---------------------------------------------------------------------------
CONFIG_UART_ISR_IN_IRAM=y

# ---------------------------------------------------------------------------
# CUBE32 Board — always required
# ---------------------------------------------------------------------------
CONFIG_CUBE32_BOARD_S3_CORE=y

# ---------------------------------------------------------------------------
# CUBE32 Subsystems — synchronized with the development RTC/NTP profile
# ---------------------------------------------------------------------------
CONFIG_CUBE32_DISPLAY_ENABLED=y
CONFIG_CUBE32_LVGL_ENABLED=y
CONFIG_CUBE32_LVGL_DOUBLE_BUFFER=y
CONFIG_CUBE32_LVGL_USE_SPIRAM=y
CONFIG_CUBE32_LVGL_BUFFER_LINES=20
CONFIG_CUBE32_LVGL_TASK_PRIORITY=4
CONFIG_CUBE32_LVGL_TASK_STACK_SIZE=8192
CONFIG_CUBE32_TOUCH_ENABLED=y
CONFIG_CUBE32_IMU_ENABLED=n
CONFIG_CUBE32_MAG_ENABLED=n
CONFIG_CUBE32_AUDIO_ENABLED=n
CONFIG_CUBE32_SDCARD_ENABLED=n
CONFIG_CUBE32_CAMERA_ENABLED=n
CONFIG_CUBE32_MODEM_ENABLED=y
CONFIG_CUBE32_PMU_ENABLED=y
CONFIG_CUBE32_BLE_OTA_ENABLED=y
CONFIG_CUBE32_RTC_ENABLED=y
CONFIG_CUBE32_ADC_BUTTON_ENABLED=n

# ---------------------------------------------------------------------------
# CUBE32 WiFi Configuration — required as the NTP connectivity fallback
# ---------------------------------------------------------------------------
CONFIG_CUBE32_WIFI_SSID="myssid"
CONFIG_CUBE32_WIFI_PASSWORD="mypassword"
CONFIG_CUBE32_WIFI_SAE_PWE_BOTH=y
CONFIG_CUBE32_WIFI_PW_ID=""
CONFIG_CUBE32_WIFI_MAX_RETRY=5
CONFIG_CUBE32_WIFI_AUTH_WPA2_PSK=y

# ---------------------------------------------------------------------------
# [OPTIONAL] WiFi — required by the RTC/NTP fallback connection
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# ---------------------------------------------------------------------------
# Modem — development profile uses the A7670 UART connection.
# PPP and USB Host remain enabled for the modem support stack.
# WARNING: TinyUSB (USB Device) MUST be disabled — it conflicts with USB Host.
# ---------------------------------------------------------------------------
CONFIG_CUBE32_MODEM_A7670=y
CONFIG_CUBE32_MODEM_CONNECTION_UART=y
CONFIG_CUBE32_MODEM_UART_BAUD_RATE=115200
CONFIG_CUBE32_MODEM_AUTO_CONNECT=y
CONFIG_CUBE32_MODEM_NETWORK_TIMEOUT_MS=120000
CONFIG_CUBE32_BLE_OTA_MTU_SIZE=512

CONFIG_ESP_MODEM_ADD_FLOW_CONTROL=y
CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=y
CONFIG_ESP_MODEM_PPP_SERVER_SUPPORT=y

# PPP stack support
CONFIG_PPP_SUPPORT=y
CONFIG_PPP_PAP_SUPPORT=y
CONFIG_PPP_CHAP_SUPPORT=y
CONFIG_PPP_MSCHAP_SUPPORT=y
CONFIG_PPP_MPPE_SUPPORT=y
# Explicitly enable the LwIP implementation that exposes ESP_NETIF_DEFAULT_PPP.
CONFIG_LWIP_PPP_SUPPORT=y

# USB Host for A7670 modem
CONFIG_TINYUSB_ENABLED=n
CONFIG_USB_OTG_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
CONFIG_USB_HOST_HW_BUFFER_BIAS_BALANCED=y

# ---------------------------------------------------------------------------
# [ALWAYS ON] Bluetooth — NimBLE required by CUBE32_BLE_OTA_ENABLED
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# BLE OTA speed optimisation — larger MTU/ACL/buffers for faster mobile transfer
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=512
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=32

# ---------------------------------------------------------------------------
# LVGL 9.x — the built-in font selections synchronize with the development
# RTC/NTP profile. ble_ota_ui.cpp requires 10, 20, and 24; the UI uses 14.
# The application falls back to 24 when larger optional fonts are unavailable.
# ---------------------------------------------------------------------------
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
